{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:athena:hermes-radio:bridge-v1",
  "title": "Existing Athena gateway native bridge, lean radio subset",
  "description": "Documentation of unchanged pkg/athena/bridge Request/Response fields. Runtime contract.py also checks duplicate keys, UTF-8, finite numbers, UTC timestamp order, safe text and directional byte caps. Not an additional wire envelope.",
  "oneOf": [{"$ref": "#/$defs/request"}, {"$ref": "#/$defs/response"}],
  "x-http": {"method": "POST", "path": "/radio/v1/exchange", "bind": "127.0.0.1", "default_port": 8650},
  "x-limits": {"request_bytes": 65536, "response_bytes": 65536, "transcript_utf8_bytes": 32000, "speech_characters": 350, "active_exchanges": 1},
  "$defs": {
    "utc": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|\\+00:00)$"},
    "request": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transmission_id", "transcript", "speaker", "frequency_hz", "modulation", "received_at", "transcribed_at"],
      "properties": {
        "transmission_id": {"type": "string", "minLength": 1},
        "transcript": {"type": "string", "minLength": 1, "maxLength": 32000},
        "speaker": {"type": "string", "minLength": 1, "description": "Exact configured admitted speaker; default Prometheus. Gateway owns dynamic SRS admission."},
        "addressee": {"const": ""},
        "frequency_hz": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
        "modulation": {"enum": ["AM", "FM"]},
        "received_at": {"$ref": "#/$defs/utc"},
        "transcribed_at": {"$ref": "#/$defs/utc"}
      }
    },
    "response": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transmission_id", "deliverable", "speech", "intent_class", "state"],
      "properties": {
        "transmission_id": {"type": "string", "minLength": 1, "description": "Exact request echo."},
        "deliverable": {"type": "boolean"},
        "speech": {"type": "string", "maxLength": 350},
        "intent_class": {"enum": ["factual", "cue", "action_preview", "unrecognized"]},
        "state": {"enum": ["ok", "stale", "degraded", "unavailable", "ownship_ambiguous"]},
        "suppression_reason": {"type": "string"},
        "route": {"enum": ["fixed", "llm", "debrief", "fallback"], "description": "Optional (phase 1): which path wrote the speech. Deliverable frames only."},
        "model": {"type": "string", "minLength": 1, "maxLength": 64, "description": "Optional (phase 1): the model that wrote the speech; needs route."}
      },
      "if": {"properties": {"deliverable": {"const": true}}},
      "then": {"properties": {"speech": {"minLength": 1}, "intent_class": {"const": "factual"}, "suppression_reason": {"const": ""}}},
      "else": {"required": ["suppression_reason"], "properties": {"speech": {"const": ""}, "suppression_reason": {"minLength": 1}}}
    }
  }
}
