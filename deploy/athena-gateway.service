[Unit]
Description=Athena Audio Gateway (SRS command channel)
Documentation=https://github.com/pcorajr/athena-audio-gateway
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=athena-gateway
Group=athena-gateway
WorkingDirectory=/opt/athena-gateway

# Piper resolves its voice-data directory through XDG. A system account with
# no home directory would otherwise resolve XDG_DATA_HOME to /usr/local/share,
# which is root-owned, and the gateway fails at startup with
# "cannot install piper voice: Cannot create temp dir". StateDirectory gives
# the service a writable /var/lib/athena-gateway that systemd creates and
# chowns automatically.
StateDirectory=athena-gateway
Environment=HOME=/var/lib/athena-gateway
Environment=XDG_DATA_HOME=/var/lib/athena-gateway/.local/share

# The Hermes API key is a credential. It is passed through the environment
# rather than a command-line flag, because a flag value is visible in `ps`
# output and lands in shell history. The file is mode 0600 and owned by the
# service account.
#
# Marked optional so the gateway still starts receive-only when no bridge is
# configured; the application warns if an endpoint is set without a key.
EnvironmentFile=-/etc/athena-gateway/secrets.env

ExecStart=/opt/athena-gateway/bin/skyeye --config-file=/etc/athena-gateway/config.yaml

# The gateway is an ordinary SRS client. Restarting it cannot disrupt DCS or
# the pilot's own radios, so restart freely -- but back off, because the usual
# cause of a crash loop is SRS being unreachable, and hammering it does not
# help.
Restart=always
RestartSec=30

# Hardening. The gateway needs the network, its model file, and nothing else.
# It writes no files at runtime: audio is held in memory only and never
# persisted (ADR 0014).
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ProtectClock=true
ProtectHostname=true
RestrictSUIDSGID=true
RestrictRealtime=true
RestrictNamespaces=true
LockPersonality=true
MemoryDenyWriteExecute=false
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged @resources

# Read-only access to the config and model. No writable paths are granted; if a
# future change needs one, add it explicitly rather than relaxing
# ProtectSystem.
ReadOnlyPaths=/etc/athena-gateway
ReadOnlyPaths=/opt/athena-gateway

# GPU access for local Whisper. Only needed for a Vulkan/GPU build; the
# default CPU build on athena's 32-core i9 does not require it. Harmless to
# leave in place, and required if you later switch to the Vulkan build.
DeviceAllow=/dev/dri rw
SupplementaryGroups=video render

# Journal only. Transcript logging is off by default; enabling it writes what
# the pilot said into the journal.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
